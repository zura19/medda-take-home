# Copy to .env.local and fill in.
# LLM_PROVIDER: mock | anthropic | openai
#   mock      -> returns a canned response, no key needed (good for Parts 1 and 2)
#   anthropic -> Claude API
#   openai    -> any OpenAI-compatible API (OpenAI, Gemini's OpenAI-compatible endpoint, a local model, ...)
LLM_PROVIDER=mock

# Model name for the provider you choose, e.g. claude-haiku-5-5, gpt-4.1-mini, gemini-2.5-flash
LLM_MODEL=

ANTHROPIC_API_KEY=

OPENAI_API_KEY=
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://api.openai.com/v1
